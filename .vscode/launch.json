      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}/apps/jobs",
      "serverReadyAction": {
        "pattern": "Local:\\s+https?://\\S+:3006",
        "action": "startDebugging",
        "name": "Chrome: Jobs",
        "killOnServerStop": true
      }
    },
    {
