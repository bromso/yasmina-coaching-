      "url": "http://account.brand.localhost:3003",
      "webRoot": "${workspaceFolder}/apps/account",
      "browserLaunchLocation": "ui"
    },
    {
      "name": "Next: Docs",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}/apps/docs",
      "serverReadyAction": {
        "pattern": "Local:\\s+https?://\\S+:3004",
        "action": "startDebugging",
