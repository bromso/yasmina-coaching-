      "url": "http://blog.brand.localhost:3009",
      "webRoot": "${workspaceFolder}/apps/blog",
      "browserLaunchLocation": "ui"
    },

    // ===== Bun services (oven.bun-vscode): breakpoints in src/, hot reload like `bun run dev` =====
    {
      "name": "Bun: API",
      "type": "bun",
      "request": "launch",
      "program": "src/index.ts",
      "cwd": "${workspaceFolder}/apps/api",
      "env": { "NODE_ENV": "development" },
      "watchMode": "hot"
    },
    {
      "name": "Bun: AI",
      "type": "bun",
      "request": "launch",
      "program": "src/index.ts",
      "cwd": "${workspaceFolder}/apps/ai",
      "env": { "NODE_ENV": "development" },
      "watchMode": "hot"
    },
    {
      "name": "Bun: test current file",
      "type": "bun",
      "request": "launch",
      // No timeout: a test paused on a breakpoint would otherwise fail after Bun's default 5 s.
      "runtimeArgs": ["test", "--timeout", "0"],
      "program": "${file}",
      "cwd": "${fileWorkspaceFolder}"
    },

    // ===== Tooling =====
    {
      "name": "Storybook",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}/apps/story",
      "serverReadyAction": {
        "pattern": "localhost:6006",
        "action": "startDebugging",
        "name": "Chrome: Storybook",
        "killOnServerStop": true
      }
    },
    {
      "name": "Chrome: Storybook",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:6006",
      "webRoot": "${workspaceFolder}/apps/story",
      "browserLaunchLocation": "ui"
    }
  ],
  "compounds": [
    {
      // What /notes and /chat need: the api, the AI service, the app and sign-in.
      "name": "Stack: app",
      "configurations": ["Bun: API", "Bun: AI", "Next: App", "Next: Auth"],
      "stopAll": true
    },
    {
      "name": "Stack: everything",
      "configurations": [
        "Bun: API",
        "Bun: AI",
        "Next: WWW",
        "Next: App",
        "Next: Auth",
        "Next: Account",
        "Next: Docs",
        "Next: Help",
        "Next: Jobs",
        "Next: Blog"
      ],
      "stopAll": true
    }
  ]
}
