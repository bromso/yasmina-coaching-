{
  // One place for every debug config: opening the repo folder or workspace.code-workspace (its
  // 🏠 Root folder) shows the same list. Inside the devcontainer the servers run in the container
  // and `browserLaunchLocation: "ui"` opens Chrome on your machine against the forwarded ports, so
  // the *.brand.localhost URLs (and the session cookie) work in both. Next server breakpoints work
  // there too: the dev image ships Node (js-debug hooks Node processes, not Bun).
  // Each serverReadyAction pattern names its app's port: VS Code checks every debug terminal's
  // output against every waiting pattern, so a shared one ("Ready in") opens the wrong browser.
  // e2e is a task (`e2e: all journeys`) or the Playwright extension, not a debug config.
  // scripts/vscode.test.ts keeps it in step with the apps, SITES and the dev scripts.
  "version": "0.2.0",
  "configurations": [
    // ===== Next apps: server (auto-attaches to next dev) + Chrome, opened when it is ready =====
    {
      "name": "Next: WWW",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}/apps/www",
      "serverReadyAction": {
        "pattern": "Local:\\s+https?://\\S+:3000",
        "action": "startDebugging",
        "name": "Chrome: WWW",
        "killOnServerStop": true
      }
    },
    {
      "name": "Chrome: WWW",
      "type": "chrome",
      "request": "launch",
      "url": "http://www.brand.localhost:3000",
      "webRoot": "${workspaceFolder}/apps/www",
      "browserLaunchLocation": "ui"
    },
    {
      "name": "Next: App",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}/apps/app",
      "serverReadyAction": {
        "pattern": "Local:\\s+https?://\\S+:3001",
        "action": "startDebugging",
        "name": "Chrome: App",
        "killOnServerStop": true
      }
    },
    {
      "name": "Chrome: App",
      "type": "chrome",
      "request": "launch",
      "url": "http://app.brand.localhost:3001",
      "webRoot": "${workspaceFolder}/apps/app",
      "browserLaunchLocation": "ui"
    },
    {
      "name": "Next: Auth",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}/apps/auth",
      "serverReadyAction": {
        "pattern": "Local:\\s+https?://\\S+:3002",
        "action": "startDebugging",
        "name": "Chrome: Auth",
        "killOnServerStop": true
      }
    },
    {
      "name": "Chrome: Auth",
      "type": "chrome",
      "request": "launch",
      "url": "http://auth.brand.localhost:3002",
      "webRoot": "${workspaceFolder}/apps/auth",
      "browserLaunchLocation": "ui"
    },
    {
      "name": "Next: Account",
      "type": "node-terminal",
      "request": "launch",
      "command": "bun run dev",
      "cwd": "${workspaceFolder}/apps/account",
      "serverReadyAction": {
        "pattern": "Local:\\s+https?://\\S+:3003",
