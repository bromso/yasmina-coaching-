      "command": "bun run dev",
      "cwd": "${workspaceFolder}/apps/blog",
      "serverReadyAction": {
        "pattern": "Local:\\s+https?://\\S+:3009",
        "action": "startDebugging",
        "name": "Chrome: Blog",
        "killOnServerStop": true
      }
    },
    {
      "name": "Chrome: Blog",
      "type": "chrome",
