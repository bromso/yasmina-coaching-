{
  "permissions": {
    "allow": [
      "Bash(npm view *)",
      "Bash(bun run lint)",
      "Bash(bun run check)",
      "Bash(bun run build)",
      "Bash(bun run typecheck)",
      "Bash(bun run format)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "mcp__figma-console__figma_capture_screenshot",
      "mcp__figma-console__figma_take_screenshot",
      "mcp__figma-console__figma_get_variables",
      "mcp__figma-console__figma_get_status",
      "mcp__figma-console__figma_list_open_files",
      "mcp__claude_ai_Figma__search_design_system"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); [ -n \"$f\" ] && bunx @biomejs/biome check --write --files-ignore-unknown=true \"$f\" || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "buildkite@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  }
}
