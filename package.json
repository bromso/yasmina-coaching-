{
  "name": "@repo/mono",
  "description": "Frontend monorepo boilerplate",
  "author": {
    "name": "Jonas Bröms",
    "email": "jonas.broms@gmail.com"
  },
  "repository": {
    "url": "https://github.com/bromso/boilerplate-bun"
  },
  "keywords": [
    "boilerplate",
    "monorepo",
    "next.js"
  ],
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "next": "^16.4.5",
    "next-intl": "4.14.9",
    "use-intl": "4.14.9",
    "sharp": "^0.35.3",
    "postcss": "^8.5.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "@iconify/react": "^6.0.4",
    "zod": "^4.6.7",
    "fumadocs-mdx": "15.5.0",
    "fumadocs-core": "16.18.0",
    "@hookform/resolvers": "^5.9.2",
    "react-hook-form": "^7.91.0",
    "@serwist/next": "^9.5.13",
    "serwist": "^9.2.3",
    "clsx": "^2.1.1",
    "class-variance-authority": "^0.7.1",
    "web-vitals": "^6.2.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "react-day-picker": "^9.14.0",
    "recharts": "^3.10.1",
    "cmdk": "^1.1.1",
    "vaul": "^1.1.2",
    "input-otp": "^1.5.0",
    "sonner": "^2.0.8",
    "react-icons": "^5.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@next/bundle-analyzer": "^16.4.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^25.9.9",
    "@types/bun": "^1.4.4",
    "@orpc/client": "^1.16.2",
    "@orpc/contract": "^1.16.2",
    "@orpc/openapi": "^1.16.2",
    "@orpc/server": "^1.15.4",
    "@orpc/zod": "^1.16.2",
    "ai": "^7.0.156",
    "@ai-sdk/anthropic": "^4.0.97",
    "@ai-sdk/react": "^4.0.167",
    "@tailwindcss/vite": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.2.0",
    "nodemailer": "^10.3.1",
    "@types/nodemailer": "^8.0.2",
    "arctic": "^3.7.0",
    "stripe": "^23.1.0",
    "@simplewebauthn/server": "^13.3.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@playwright/test": "^1.65.0",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 bun run --filter '*' build",
    "build:app": "bun run --filter @repo/app build",
    "build:www": "bun run --filter @repo/www build",
    "dev": "bun run --filter '*' dev",
    "dev:app": "bun run --filter @repo/app dev",
    "dev:www": "bun run --filter @repo/www dev",
    "dev:api": "bun run --filter @repo/api dev",
    "dev:ai": "bun run --filter @repo/ai dev",
    "start": "bun run --filter '*' start",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "typecheck": "bun run --filter @repo/app --filter @repo/www --filter @repo/blog --filter @repo/docs --filter @repo/help --filter @repo/jobs --filter @repo/api --filter @repo/api-contract --filter @repo/public-api-contract --filter @repo/ai --filter @repo/ai-contract --filter @repo/service-kit --filter @repo/sites --filter @repo/content --filter @repo/email --filter @repo/session --filter @repo/telemetry --filter @repo/i18n --filter @repo/i18n-guard --filter @repo/log --filter @repo/auth --filter @repo/account --filter @repo/e2e --filter @repo/load --filter @repo/story typecheck",
    "typecheck:ui": "bun run --filter @repo/ui typecheck",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test:services": "bun run --filter @repo/api --filter @repo/ai --filter @repo/app --filter @repo/service-kit --filter @repo/ui --filter @repo/api-contract --filter @repo/public-api-contract --filter @repo/sites --filter @repo/content --filter @repo/email --filter @repo/session --filter @repo/telemetry --filter @repo/i18n --filter @repo/i18n-guard --filter @repo/log --filter @repo/auth --filter @repo/account --filter @repo/www --filter @repo/blog --filter @repo/docs --filter @repo/help --filter @repo/jobs --filter @repo/load test",
    "validate": "bun test scripts && biome check . --max-diagnostics=none && bun run typecheck && bun run typecheck:ui && bun run typecheck:scripts && bun run test:services && bun run build",
    "ci": "bun test scripts && biome ci . --max-diagnostics=none && bun run typecheck && bun run typecheck:ui && bun run typecheck:scripts && bun run test:services && bun run build",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/.next packages/tokens/dist apps/story/storybook-static apps/api/dist apps/ai/dist",
    "doctor": "bun scripts/doctor.ts",
    "security": "bun scripts/security/run.ts",
    "security:image": "bun scripts/security/image.ts --build",
    "perf:measure": "bun perf/measure.ts",
    "perf:update": "bun perf/update.ts",
    "icons:bundle": "bun scripts/generate-icon-bundle.ts",
    "story": "bun --filter @repo/story dev",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset tag",
    "release": "bun run build && changeset publish",
    "prepare": "husky",
    "commit": "cz",
    "commitlint": "commitlint --edit"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@iconify-json/lucide": "^1.2.151",
    "@iconify/utils": "^3.1.7",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/language-server": "^0.16.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "sharp": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-language-server": "^5.3.0"
  },
  "overrides": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tmp": "^0.2.7",
    "undici": "^7.30.1",
    "@serwist/build>zod": "catalog:",
    "@serwist/next>zod": "catalog:",
    "@serwist/webpack-plugin>zod": "catalog:"
  }
}
