{
  "name": "@repo/www",
  "version": "1.1.0",
  "description": "Marketing site — leadership coaching by Yasmina Petersson",
  "private": true,
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 115",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "opera >= 95",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "next dev --hostname ${DEV_HOSTNAME:-www.brand.localhost}",
    "build": "next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "dependencies": {
