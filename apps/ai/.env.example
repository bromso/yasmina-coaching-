# Copy to apps/ai/.env — Bun loads it automatically. Every value below is optional in
# development; the defaults are shown.

# NODE_ENV defaults to production (fail closed: Bun never sets it). `bun dev` sets development.
# A production deploy must set AI_SERVICE_TOKEN and the provider key (e.g. ANTHROPIC_API_KEY).
# NODE_ENV=production

# Model that serves requests, as "provider:model". Shipped providers: anthropic, mock.
# AI_MODEL=anthropic:claude-opus-5

# Read by @ai-sdk/anthropic. Without it, development falls back to mock:echo (with a warning)
# and production refuses to start.
# ANTHROPIC_API_KEY=

# Bearer token callers must send. Development/test default: dev-only-insecure-token.
# Required in production, at least 32 characters — generate one with `openssl rand -hex 32`.
# The service refuses to start without it, with a shorter one, or with the dev token above.
# AI_SERVICE_TOKEN=

# Comma-separated exact origins allowed, for callers that send an Origin header — defense in
# depth, not a browser gateway: the service has no CORS, so browsers cannot call it directly. Call
# it from your backend. Development also allows any localhost origin; production allows none.
# AI_ALLOWED_ORIGINS=https://app.brand.com

# ai.brand.localhost binds loopback only — set HOST=0.0.0.0 for container/VM deploys.
# HOST=ai.brand.localhost
# PORT=3008

# Cost and safety limits.
# AI_MAX_MESSAGES=50
# AI_MAX_MESSAGE_BYTES=32768
# AI_MAX_OUTPUT_TOKENS=4096
# AI_MAX_STEPS=5
# AI_RATE_LIMIT=30
# AI_RATE_WINDOW_SECONDS=60

# Error reporting through apps/api's telemetry.ingest: unexpected 5xx, an unhandled throw, a chat
# stream that ends in failure — reported as "<log key>: <ErrorName>" only, never the provider's
# message or a stack (both can carry secrets and model output). Both optional; unset means no
# reporting (one log line at boot).
# API_URL=http://api.brand.localhost:3007
# API_SERVICE_TOKEN=

# Structured logging (@repo/log): debug|info|warn|error (default info; an invalid value falls
# back to info with one warning line) and json|pretty (default json in production, pretty
# otherwise). This service exposes no /metrics (only apps/api and its worker do).
# LOG_LEVEL=info
# LOG_FORMAT=

# The server-side request deadline, in ms (1000–600000): a request with no response by then gets
# 503 "The request took too long. It may still complete — check before retrying." (the handler
# keeps running — including the provider call, see README — and may still complete; treat the
# 503 as an unknown outcome, not a clean failure). A chat stream that already started is not cut.
# REQUEST_TIMEOUT_MS=30000
