# Copy to apps/api/.env — Bun loads it automatically. Outside production every value below is
# optional and the defaults are shown; production requires API_SERVICE_TOKEN, AUTH_URL,
# ACCOUNT_URL and APP_URL (and MAIL_FROM with a real mail provider).

# NODE_ENV defaults to production (fail closed: Bun never sets it). `bun dev` sets development,
# which serves Bun's development error pages.
# NODE_ENV=production

# Where the server listens. Docker sets HOST=0.0.0.0.
# HOST=api.brand.localhost
# PORT=3007

# Bun.sql picks the engine from the URL. Supported and tested: sqlite:// (default) and
# postgres://. Migrations in src/migrations/ run at startup and via `bun run db:migrate`.
# DATABASE_URL=sqlite://.data/api.db

# Bearer token callers must send. Development/test default: dev-only-insecure-api-token.
# Required in production, at least 32 characters — generate one with `openssl rand -hex 32`.
# The service refuses to start without it, with a shorter one, or with the dev token above.
# API_SERVICE_TOKEN=

# Comma-separated exact origins allowed, for callers that send an Origin header.
# API_ALLOWED_ORIGINS=

# Requests per window per client (x-api-client-id, else IP), and the window length.
# API_RATE_LIMIT=300
# API_RATE_WINDOW_SECONDS=60

# Sign-ups per window, api-wide (independent of the client id: each sign-up mails a verify link).
# SIGNUP_RATE_LIMIT=30
# SIGNUP_RATE_WINDOW_SECONDS=600
# Sign-ups per normalised email, per hour.
# SIGNUP_EMAIL_RATE_LIMIT=3
# Magic-link requests per window, api-wide (silent when tripped).
# MAGIC_LINK_RATE_LIMIT=30
# MAGIC_LINK_RATE_WINDOW_SECONDS=600
# Password-reset requests per window, api-wide (silent when tripped).
# PASSWORD_RESET_RATE_LIMIT=30
# PASSWORD_RESET_RATE_WINDOW_SECONDS=600
# Telemetry events per browser per minute.
# TELEMETRY_RATE_LIMIT=60
# All of these are in memory, per process: N replicas allow N times the setting.

# Largest request body accepted; Bun answers 413 above it before any parsing.
# API_MAX_BODY_BYTES=262144

# Where password-reset links point; the auth app. A trailing slash is dropped.
# Development/test default: http://auth.brand.localhost:3002. Required in production: the service
# refuses to start without it rather than mail links to a host that does not exist.
# AUTH_URL=

# Where account links in mail point (the password-changed notice); the account app. A trailing
# slash is dropped. Development/test default: http://account.brand.localhost:3003. Required in
# production.
# ACCOUNT_URL=

# Where invitation links in mail point (`/invitations/<token>`); the app. A trailing slash is
# dropped. Development/test default: http://app.brand.localhost:3001. Required in production.
# APP_URL=

# The site's parent domain (shared with the Next apps, read by @repo/sites). The waitlist welcome
# mail links to https://www.<SITE_DOMAIN>. Unset: http://www.brand.localhost:3000 (with a warning
# in production). It is also PASSKEY_RP_ID's default. Set it in production.
# SITE_DOMAIN=brand.com

# The passkey relying party id. Unset: SITE_DOMAIN, else brand.localhost. The api exits at startup
# unless it equals, or is a parent domain of, both the AUTH_URL and ACCOUNT_URL hosts.
# PASSKEY_RP_ID=brand.com

# Which adapter sends mail: log (writes it to the console; the default), smtp, resend or file
# (writes each message as JSON to MAIL_DIR instead of sending it — for apps/e2e and other local
# runs that need the links without a real provider). log and file both expose the links, so the
# service warns at startup in production when either is selected.
# MAIL_PROVIDER=log

# The sender. Development default: Boilerplate <no-reply@brand.localhost>. Required in production
# for smtp and resend — a real provider refuses the placeholder domain.
# MAIL_FROM=

# Where help-center support requests are mailed (Reply-To: the sender). Unset → MAIL_FROM's
# address; the api warns at startup in production without it.
# SUPPORT_EMAIL=

# Where job applications are mailed (Reply-To: the applicant). Unset → wherever support requests
# go (SUPPORT_EMAIL, else MAIL_FROM's address).
# HIRING_EMAIL=

# MAIL_PROVIDER=smtp: the server's URL, e.g. smtp://user:pass@smtp.example.com:587 (Mailpit:
# smtp://localhost:1025). Required with smtp.
# SMTP_URL=

# MAIL_PROVIDER=resend: the API key from resend.com. Required with resend.
# RESEND_API_KEY=

# MAIL_PROVIDER=file: the directory each message is written to as <ms>-<hex>.json. Required with
# file, at any NODE_ENV. apps/e2e sets this to apps/e2e/.tmp/mail.
# MAIL_DIR=

# Billing: mock (the default; plans activate at once with no payment, and the api warns at startup
# in production) or stripe. With stripe all six keys below are required; a missing one refuses to
# start, naming it.
# BILLING_PROVIDER=mock
# Stripe → Developers → API keys: the secret key (sk_test_… / sk_live_…).
# STRIPE_SECRET_KEY=
# The signing secret of the webhook endpoint (whsec_…).
# STRIPE_WEBHOOK_SECRET=
# Price ids (price_…) per plan and interval: prices live in Stripe, never in code.
# STRIPE_PRICE_PRO_MONTH=
# STRIPE_PRICE_PRO_YEAR=
# STRIPE_PRICE_TEAM_MONTH=
# STRIPE_PRICE_TEAM_YEAR=

# Platform admins: comma-separated emails. A listed address becomes a superadmin once its email is
# verified (computed per request; remove it to revoke). Empty → nobody can open /admin.
# SUPERADMIN_EMAILS=

# Telemetry: errors and web vitals always land in telemetry_errors / telemetry_vitals, shown on
# /admin. store (the default) keeps them there only; sentry also forwards each new error to
# Sentry's envelope endpoint over plain fetch (no SDK) — vitals never leave. See docs/guides/sentry.md.
# TELEMETRY_PROVIDER=store

# Required with TELEMETRY_PROVIDER=sentry: the DSN from your Sentry project settings. A bad DSN
# fails at startup.
# SENTRY_DSN=

# Tag sent on every forwarded event. Empty → NODE_ENV.
# SENTRY_ENVIRONMENT=

# Analytics: pageviews and product events always land in analytics_pageviews / analytics_events,
# rolled up into analytics_daily and shown on /admin/analytics. store (the default) keeps them
# there only; posthog or plausible also forward each one over plain fetch (no ip, user agent, or
# cookie ever leaves). See docs/guides/analytics.md.
# ANALYTICS_PROVIDER=store

# Requests per client id per minute (the Next routes key it per browser); the per-app backstop
# stays 6000.
# ANALYTICS_RATE_LIMIT=120

# How long analytics.prune keeps raw pageview/event rows; analytics_daily is kept indefinitely.
# ANALYTICS_RETENTION_DAYS=90

# Required with ANALYTICS_PROVIDER=posthog: the project API key and ingestion host (e.g.
# https://us.i.posthog.com or https://eu.i.posthog.com).
# POSTHOG_KEY=
# POSTHOG_HOST=

# Required with ANALYTICS_PROVIDER=plausible: the site domain registered in Plausible and the
# instance's host (https://plausible.io for the hosted service, or your self-hosted url).
# PLAUSIBLE_DOMAIN=
# PLAUSIBLE_HOST=

# Social sign-in. Each provider is offered only when all of its keys are set; setting some but not
# all of them refuses to start. Register each provider's redirect URI as
# ${AUTH_URL}/oauth/<provider>/callback, e.g. http://auth.brand.localhost:3002/oauth/google/callback.

# Google: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Redirect URI: ${AUTH_URL}/oauth/google/callback
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub: GitHub → Settings → Developer settings → OAuth Apps. Authorization callback URL:
# ${AUTH_URL}/oauth/github/callback
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# Apple: Apple Developer → Certificates, Identifiers & Profiles. CLIENT_ID is the Services ID,
# TEAM_ID your team, KEY_ID and PRIVATE_KEY a "Sign in with Apple" key (the .p8 file's PKCS#8 PEM;
# a single line with \n escapes works). Return URL: ${AUTH_URL}/oauth/apple/callback
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_TEAM_ID=
# OAUTH_APPLE_KEY_ID=
# OAUTH_APPLE_PRIVATE_KEY=

# Two-factor authentication: encrypts the stored TOTP secret (AES-256-GCM), 32 bytes base64.
# Generate one with `openssl rand -base64 32`. Not derived from API_SERVICE_TOKEN — rotating that
# would lock every 2FA user out. Development/test default: a fixed, zero-free 32-byte key.
# Required in production: the service refuses to start without it.
# TWO_FACTOR_ENCRYPTION_KEY=

# Uploads (avatars, workspace logos): local (the default; files on this machine's disk under
# STORAGE_DIR, and the api warns at startup in production — fine for one node with a volume, wrong
# for several) or s3, any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, SeaweedFS). See
# docs/guides/storage.md.
# STORAGE_PROVIDER=local
# Where the local provider keeps files, relative to the api's working directory.
# STORAGE_DIR=.data/storage
# Serve images from a public bucket or a CDN at <url>/<key> instead of the apps' /files route.
# Empty → /files/<key> on each app's own origin.
# STORAGE_PUBLIC_URL=
# Required with STORAGE_PROVIDER=s3 (a missing one refuses to start, naming it).
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional: the endpoint of a non-AWS bucket, e.g. https://<account>.r2.cloudflarestorage.com (R2,
# with S3_REGION=auto) or http://localhost:8333 (the Compose SeaweedFS, keys devstorage /
# devstorage-secret). Empty → AWS S3 in S3_REGION.
# S3_ENDPOINT=

# Background jobs. By default this process runs the job worker and the cron scheduler alongside
# the api; set JOBS_WORKER=false when a dedicated worker (`src/worker.ts`, `bun run dev:worker`)
# runs them instead (that process ignores JOBS_WORKER). true/false, 1/0, yes/no or on/off.
# JOBS_WORKER=true
# Jobs one process runs at once (1-50).
# JOBS_CONCURRENCY=4
# How often the worker looks for due jobs, in ms (100-60000); an enqueue wakes it at once anyway.
# JOBS_POLL_MS=1000
# Of those, how many webhook.deliver jobs at once (1 to JOBS_CONCURRENCY; unset → 2, or
# JOBS_CONCURRENCY when lower), so endpoints that hang never take every slot from mail.
# WEBHOOK_CONCURRENCY=2

# Nightly backups (backup.run, 0 2 * * *, UTC): off by default. A gzipped logical dump of the
# whole database (not jobs or schema_migrations) goes to the storage seam under
# backups/<date>/<engine>-<time>.jsonl.gz; backup.run then deletes its own objects there older
# than BACKUP_RETENTION_DAYS (storage.sweep never looks under backups/). See
# docs/guides/operations.md and bun run --filter @repo/api backup / restore.
# BACKUP_ENABLED=false
# BACKUP_RETENTION_DAYS=14
# The nightly storage.sweep (30 3 * * *), on by default; false pauses it without stopping the
# other jobs — after a restore, until the bucket and the database agree again.
# STORAGE_SWEEP_ENABLED=true
# Outgoing webhooks to http(s) on localhost and *.localhost (dialled at 127.0.0.1): off unless
# set, in any NODE_ENV. Local development and the e2e stack only — never a real deployment (the
# api and the worker warn at startup when it is on in production).
# WEBHOOK_ALLOW_LOCALHOST_HTTP=false

# Realtime: which bus publishes and subscribes events (note created/deleted, presence, resync).
# Unset (the default) picks it from DATABASE_URL's dialect: postgres for Postgres, memory for
# SQLite (correct only for one api process). Set to override either way.
# REALTIME_BUS=
# Process-wide cap on open event streams (the /events endpoint); beyond it, 503.
# REALTIME_MAX_STREAMS=1000

# Structured logging (@repo/log): debug|info|warn|error (default info; an invalid value falls
# back to info with one warning line) and json|pretty (default json in production, pretty
# otherwise). The dedicated worker (src/worker.ts) reads the same two.
# LOG_LEVEL=info
# LOG_FORMAT=

# The bearer token GET /metrics requires, at least 24 characters. Unset (the default) → /metrics
# answers 404 — off by default, never silently open. A missing or wrong token answers 401. The
# dedicated worker's own /metrics reads the same token.
# METRICS_TOKEN=

# Shown as build_info{version,commit} on /metrics (the api's own package version is the other
# label). Typically set to the deploying commit's short SHA. Unset → "unknown".
# GIT_COMMIT=

# How long /ready (and the dedicated worker's /health) waits for the database ping before
# answering 503 "Not ready (timed out)", in ms (100–60000).
# READY_TIMEOUT_MS=2000

# The server-side request deadline, in ms (1000–600000): a request with no response by then gets
# 503 "The request took too long. It may still complete — check before retrying." (the handler
# keeps running and may still commit a mutation; its result is discarded, so treat the 503 as an
# unknown outcome, not a clean failure, before retrying a non-idempotent write).
# Event streams are exempt.
# REQUEST_TIMEOUT_MS=30000
