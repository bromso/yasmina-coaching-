{
  "name": "@repo/account",
  "version": "1.1.0",
  "description": "Account management shell — frontend boilerplate",
  "keywords": [
    "boilerplate",
    "next.js"
  ],
  "author": "Jonas Bröms",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3003 --hostname ${DEV_HOSTNAME:-account.brand.localhost}",
    "build": "next build --webpack",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "next start --port 3003",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "validate": "bun format && bun lint && bun check && bun run build"
  },
  "dependencies": {
    "@iconify/react": "catalog:",
    "@orpc/client": "catalog:",
    "@repo/api-contract": "workspace:*",
    "@repo/i18n": "workspace:*",
    "@repo/log": "workspace:*",
    "@repo/session": "workspace:*",
    "@repo/sites": "workspace:*",
    "@repo/telemetry": "workspace:*",
    "@repo/ui": "workspace:*",
    "@serwist/next": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "uqr": "^0.1.3",
    "web-vitals": "catalog:"
  },
  "browserslist": [
    "Chrome >= 109",
    "Firefox >= 115",
    "Safari >= 16.4",
    "Edge >= 109",
    "not dead"
  ],
  "devDependencies": {
    "@next/bundle-analyzer": "catalog:",
    "@repo/i18n-guard": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "catalog:",
    "serwist": "catalog:",
    "sharp": "catalog:"
  }
}
