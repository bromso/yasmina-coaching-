{
  "name": "@repo/story",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "storybook build",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "generate:vendored-types": "bun scripts/vendored-types.ts",
    "typecheck": "bun run --filter @repo/tokens build && bun scripts/vendored-types.ts --check && tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@iconify/react": "catalog:",
    "@repo/email": "workspace:*",
    "@repo/sites": "workspace:*",
    "@repo/tokens": "workspace:*",
    "@repo/ui": "workspace:*",
    "input-otp": "catalog:",
    "motion": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "recharts": "catalog:",
    "sonner": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-links": "^10.6.6",
    "@storybook/addon-themes": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-istanbul": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "playwright": "catalog:",
    "storybook": "^10.6.6",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
