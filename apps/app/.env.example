# apps/app → the backend services and sign-in. Every value is optional in development (`bun dev`),
# which falls back to the defaults below. Production (`next start`) requires them, never at
# `next build`: while any of API_URL, API_SERVICE_TOKEN, COOKIE_DOMAIN, AUTH_URL and APP_URL is
# missing, src/instrumentation.ts leaves the server answering every request with 500 until it is
# set; the first chat request fails without the AI pair.

# apps/api — defaults to http://api.brand.localhost:3007. Docker Compose: http://api:3007
API_URL=

# apps/api's bearer token (the value apps/api reads). Defaults to its public development token
# outside production. Server-side only: never prefix it with NEXT_PUBLIC_.
API_SERVICE_TOKEN=

# apps/ai — defaults to http://ai.brand.localhost:3008. Docker Compose: http://ai:3008
AI_SERVICE_URL=

# The same value apps/ai reads. Defaults to its public development token outside production.
# Server-side only: never prefix it with NEXT_PUBLIC_.
AI_SERVICE_TOKEN=

# The parent domain the session cookie is shared on, leading dot included. Defaults to
# .brand.localhost. Production: .brand.com
COOKIE_DOMAIN=

# apps/auth — where "Sign in" and sign-out go. Defaults to http://auth.brand.localhost:3002
AUTH_URL=

# This app's own origin — the fallback post-login target. Defaults to http://app.brand.localhost:3001
APP_URL=
