{
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": "Inter, sans-serif"
    },
    "serif": {
      "$type": "fontFamily",
      "$value": "Merriweather, serif"
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "JetBrains Mono, monospace"
    }
  },
  "tracking": {
    "normal": {
      "$type": "letterSpacing",
      "$value": "0em"
    }
  },
  "display": {
    "family": {
      "$type": "fontFamily",
      "$value": "var(--font-display), Georgia, \"Times New Roman\", serif"
    },
    "weight": {
      "$type": "fontWeight",
      "$value": "400"
    }
  },
  "text": {
    "family": {
      "$type": "fontFamily",
      "$value": "var(--font-sans)"
    },
    "weight": {
      "$type": "fontWeight",
      "$value": "400"
    }
  },
  "email": {
    "font": {
      "display": {
        "$type": "fontFamily",
        "$value": "Georgia, 'Times New Roman', serif",
        "$description": "Headings in mail: Fraunces' fallback, since web fonts are unreliable in mail clients"
      },
      "body": {
        "$type": "fontFamily",
        "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
        "$description": "Body text in mail: the system sans stack"
      }
    }
  }
}
