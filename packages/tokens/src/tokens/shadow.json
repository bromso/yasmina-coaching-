{
  "shadow": {
    "x": {
      "$type": "dimension",
      "$value": "0px"
    },
    "y": {
      "$type": "dimension",
      "$value": "4px"
    },
    "blur": {
      "$type": "dimension",
      "$value": "8px"
    },
    "spread": {
      "$type": "dimension",
      "$value": "-1px"
    },
    "opacity": {
      "$type": "number",
      "$value": "0.1"
    },
    "color": {
      "$type": "color",
      "$value": "hsl(0 0% 0%)"
    },
    "2xs": {
      "$type": "shadow",
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.05)"
    },
    "xs": {
      "$type": "shadow",
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.05)"
    },
    "sm": {
      "$type": "shadow",
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.1), 0px 1px 2px -2px hsl(0 0% 0% / 0.1)"
    },
    "DEFAULT": {
      "$type": "shadow",
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.1), 0px 1px 2px -2px hsl(0 0% 0% / 0.1)"
    },
    "md": {
      "$type": "shadow",
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.1), 0px 2px 4px -2px hsl(0 0% 0% / 0.1)"
    },
    "lg": {
      "$type": "shadow",
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.1), 0px 4px 6px -2px hsl(0 0% 0% / 0.1)"
    },
    "xl": {
      "$type": "shadow",
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.1), 0px 8px 10px -2px hsl(0 0% 0% / 0.1)"
    },
    "2xl": {
      "$type": "shadow",
      "$value": "0px 4px 8px -1px hsl(0 0% 0% / 0.25)"
    }
  }
}
