# Root .env — read by `docker compose` (docker-compose.yml). Copy to .env; never commit the copy.
# Each Bun service also has its own apps/<app>/.env.example for running it outside Docker.

# ----- Cross-app links (@repo/sites) -----
# Parent domain of the site (e.g. `acme.com`). Unset → `brand.localhost` with dev ports. Read at
# **build** time by the Next apps (static pages bake their links); `app`, `auth` and `account` also
# read it per request (the Docker image carries it in ENV for them). apps/api reads it for the links
# in its mail (e.g. the waitlist welcome) and as the passkey relying party id: docker-compose.yml
# passes PASSKEY_RP_ID=${PASSKEY_RP_ID:-${SITE_DOMAIN:-localhost}}, and the api exits at startup
# unless that covers both the AUTH_URL and ACCOUNT_URL hosts (docs/guides/passkeys.md).
SITE_DOMAIN=

# ----- Docs "Edit on GitHub" (apps/docs, build time) -----
# Optional. The repo URL of the docs content folder, e.g.
# https://github.com/<owner>/<repo>/blob/main/apps/docs/content/docs — each page's file path is
# appended. docker-compose.yml passes it to the docs build as a build arg; empty → no link.
CONTENT_REPO_URL=
# legal only, build time: `false` publishes the legal pages (no draft notice, no noindex, robots
# allowed). Empty or anything else keeps them drafts. docker-compose.yml passes it as a build arg.
LEGAL_DRAFT=

# ----- apps/api (service :3007) -----
# Bearer token callers (apps/app) must send. Required, at least 32 characters — generate one with
# `openssl rand -hex 32`. Without it (or with a shorter one) the api container exits at startup.
# apps/app, auth, account and www read the same value (www for its waitlist form, and it refuses to
# start without it). Every Next app's /api/telemetry route also reads API_URL / API_SERVICE_TOKEN to
# forward browser errors and web vitals to the api; docs, help and jobs treat both as optional —
# without them the route just drops what it receives instead of forwarding it. apps/ai reads the
# same two vars (optional) to report its own request failures through the api's telemetry.ingest.
API_SERVICE_TOKEN=

# Encrypts the stored TOTP secret (AES-256-GCM), 32 bytes base64. Generate one with
# `openssl rand -base64 32`. Required — without it, or with the public development key, the api
# container exits at startup.
TWO_FACTOR_ENCRYPTION_KEY=

# ----- Email (apps/api) -----
# Read by docker-compose.yml for api. Empty values take the Compose defaults: MAIL_PROVIDER=smtp
# into the bundled Mailpit (smtp://mailpit:1025; inbox at http://localhost:8025).
# log (print mail, links and tokens included, to the api's output), smtp or resend.
MAIL_PROVIDER=
# The sender. Empty → Boilerplate <no-reply@brand.localhost>. Required in production with smtp or
# resend — a real provider refuses the placeholder domain.
MAIL_FROM=
# Where help-center support requests are mailed (Reply-To: the sender). Empty → MAIL_FROM's
# address; the api warns at startup in production without it.
SUPPORT_EMAIL=
# Where job applications are mailed (Reply-To: the applicant). Empty → wherever support requests
# go (SUPPORT_EMAIL, else MAIL_FROM's address).
HIRING_EMAIL=
# Where new coaching bookings and booking requests are mailed (Yasmina's inbox). Unset → where
# support requests go.
BOOKING_EMAIL=
# Required with MAIL_PROVIDER=smtp, e.g. smtp://user:pass@smtp.example.com:587. Empty → Mailpit.
SMTP_URL=
# Required with MAIL_PROVIDER=resend: the API key from resend.com.
RESEND_API_KEY=
# Where the password-changed notice links: the account app. Empty → http://localhost:3003.
# apps/api exits at startup in production without it.
ACCOUNT_URL=

# ----- Storage (apps/api) -----
# Uploads (avatars, workspace logos). docker-compose.yml always points the api at its bundled
# SeaweedFS (STORAGE_PROVIDER=s3, S3_ENDPOINT=http://seaweedfs:8333, bucket uploads, region
# us-east-1) and reads only S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY from here, which are also the
# one identity SeaweedFS's S3 gateway accepts (empty → devstorage / devstorage-secret). The rest
# are for running the api image elsewhere: local (the api's default: files on this machine's disk
# under STORAGE_DIR — fine for one node with a volume, lost or split across several) or s3 (any
# S3-compatible bucket), which refuses to start without all four S3_* keys below. Setup:
# docs/guides/storage.md.
STORAGE_PROVIDER=
# Where local files live. Empty → .data/storage.
STORAGE_DIR=
# Serve files from a public bucket or CDN instead of the apps' /files route. Empty → the apps
# serve uploads themselves. A trailing slash is dropped.
STORAGE_PUBLIC_URL=
# Required with STORAGE_PROVIDER=s3.
S3_BUCKET=
S3_REGION=
# An S3-compatible endpoint other than AWS (R2, MinIO, SeaweedFS, …). Empty → AWS.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ----- Background jobs (apps/api) -----
# The api runs the job worker and cron scheduler in-process by default. JOBS_WORKER=false leaves
# that to a dedicated `bun src/worker.ts` process — in docker-compose.yml, the api-worker service:
#   JOBS_WORKER=false docker compose --profile worker up -d --build
# Concurrency 1-50 (empty → 4); poll interval in ms, 100-60000 (empty → 1000).
# docs/guides/background-jobs.md
JOBS_WORKER=
JOBS_CONCURRENCY=
JOBS_POLL_MS=

# ----- Backups (apps/api, apps/api-worker) -----
# Nightly backup.run (0 2 * * *, UTC): off by default. A gzipped logical dump of the whole
# database (not jobs or schema_migrations) goes to the storage seam under
# backups/<date>/<engine>-<time>.jsonl.gz, then backup.run deletes its own objects there past
# BACKUP_RETENTION_DAYS (empty → 14; storage.sweep never looks under backups/). See
# docs/guides/operations.md.
BACKUP_ENABLED=
BACKUP_RETENTION_DAYS=
# The nightly storage.sweep (30 3 * * *): empty → on. false pauses it without stopping other jobs
# (after a restore, until the bucket and the database agree again).
STORAGE_SWEEP_ENABLED=
# Outgoing webhooks to http(s) on localhost and *.localhost (dialled at 127.0.0.1): empty → off, in
# any NODE_ENV. Local development and the e2e stack only — never a real deployment (the api and the
# worker warn at startup when it is on in production).
WEBHOOK_ALLOW_LOCALHOST_HTTP=
# How many webhook.deliver jobs one process runs at once, so endpoints that hang can never take
# every job slot from mail and the rest: 1 to JOBS_CONCURRENCY (empty → 2, or JOBS_CONCURRENCY when
# that is lower). Equal to JOBS_CONCURRENCY leaves no slot reserved for other jobs.
WEBHOOK_CONCURRENCY=

# ----- Realtime (apps/api) -----
# Which bus publishes and subscribes events (note created/deleted, presence, resync). Empty → picked
# from DATABASE_URL's dialect: postgres for Postgres, memory for SQLite (one process only). Cap on
# open event streams per process (empty → 1000); beyond it the /events endpoint answers 503.
REALTIME_BUS=
REALTIME_MAX_STREAMS=

# ----- Logs and metrics (apps/api, its worker, apps/ai) -----
# docker-compose.yml passes these to api and api-worker (LOG_LEVEL and LOG_FORMAT to ai too);
# docker-compose.dev.yml does not, so set them in apps/api/.env / apps/ai/.env for `bun dev`
# there. Structured logging (@repo/log): LOG_LEVEL
# (debug|info|warn|error, empty → info) and LOG_FORMAT (json|pretty, empty → json in production,
# pretty otherwise). apps/ai reads the same two and exposes no /metrics.
LOG_LEVEL=
LOG_FORMAT=
# The bearer token apps/api's and its worker's GET /metrics require, at least 24 characters.
# Empty → /metrics answers 404 (off by default, never silently open).
METRICS_TOKEN=
# Shown as build_info{version,commit} on /metrics. Empty → "unknown".
GIT_COMMIT=

# ----- Billing (apps/api) -----
# Read by docker-compose.yml for api. mock (the default: plans activate at once, no payment — the
# api warns at startup in production) or stripe, which refuses to start without all six keys below.
BILLING_PROVIDER=
# Stripe → Developers → API keys: the secret key (sk_test_… / sk_live_…).
STRIPE_SECRET_KEY=
# The signing secret of the webhook endpoint (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Price ids (price_…) for each plan and interval; prices live in Stripe, never in code.
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_TEAM_MONTH=
STRIPE_PRICE_TEAM_YEAR=

# ----- Telemetry (apps/api) -----
# Read by docker-compose.yml for api. store (the default: errors and vitals land only in the api's
# tables, shown on /admin) or sentry, which also forwards each new error to Sentry over plain fetch
# (no SDK). Setup: docs/guides/sentry.md.
TELEMETRY_PROVIDER=
# Required with TELEMETRY_PROVIDER=sentry: the DSN from your Sentry project settings.
SENTRY_DSN=
# Tag sent with every forwarded event. Empty → NODE_ENV.
SENTRY_ENVIRONMENT=

# ----- Analytics (apps/api) -----
# Read by docker-compose.yml for api. store (the default: pageviews/events land only in the api's
# tables, shown on /admin/analytics) or posthog / plausible, which also forward each one over
# plain fetch (no ip, user agent, or cookie ever leaves). See docs/guides/analytics.md.
ANALYTICS_PROVIDER=
# Requests per client id per minute (the Next routes key it per browser); blank → 120. The per-app
# backstop stays 6000.
ANALYTICS_RATE_LIMIT=
# How long analytics.prune keeps raw pageview/event rows; blank → 90. analytics_daily is kept
# indefinitely.
ANALYTICS_RETENTION_DAYS=
# Required with ANALYTICS_PROVIDER=posthog: the project API key and ingestion host.
POSTHOG_KEY=
POSTHOG_HOST=
# Required with ANALYTICS_PROVIDER=plausible: the registered site domain and the instance's host.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_HOST=

# ----- Admin (apps/api) -----
# Platform admins: comma-separated emails. A listed address becomes a superadmin once its email is
# verified (computed per request; remove it to revoke). Empty → nobody can open /admin.
SUPERADMIN_EMAILS=

# ----- Social sign-in (apps/api) -----
# Read by docker-compose.yml for api. All optional: a provider's button appears only when every one
# of its vars is set; setting some but not all of a provider's vars stops the api at startup. Register
# each redirect URI as ${AUTH_URL}/oauth/<provider>/callback (Compose default AUTH_URL:
# http://localhost:3002). Setup per provider: docs/guides/oauth-providers.md.
# Google (both or neither).
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# GitHub (both or neither).
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Apple (all four or none). CLIENT_ID is the Services ID; PRIVATE_KEY the "Sign in with Apple" .p8
# key's PKCS#8 PEM on one line with \n escapes. Apple needs https Return URLs.
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
OAUTH_APPLE_PRIVATE_KEY=

# ----- apps/ai (service :3008) -----
# Bearer token callers must send. Required, at least 32 characters — generate one with
# `openssl rand -hex 32`. Without it (or with a shorter one) the ai container exits at startup.
AI_SERVICE_TOKEN=
# Model as "provider:model". Use mock:echo to run the stack without a provider key.
AI_MODEL=anthropic:claude-opus-5
# Required for anthropic:* models.
ANTHROPIC_API_KEY=
# Comma-separated exact origins allowed to send an Origin header (the service has no CORS).
AI_ALLOWED_ORIGINS=

# ----- Sign-in: app, auth (and account from Phase 4c) -----
# Read by docker-compose.yml for app/auth/account; api also reads APP_URL, for invitation links.
# Leave COOKIE_DOMAIN empty and app and auth answer
# 500 on every route (unhealthy); set your parent domain (e.g. `.brand.com`) and the public URLs for
# a shared login. Empty AUTH_URL / APP_URL fall back to http://localhost:3002 / :3001.
# The static apps (www, docs, help, jobs) also read COOKIE_DOMAIN, at build time, for the consent
# cookie: docker-compose.yml passes it to their builder stage as a build arg, defaulting to
# .brand.localhost when this is empty, so the Compose build always shares the cookie across
# subdomains without you setting anything here.
COOKIE_DOMAIN=
AUTH_URL=
APP_URL=

# Add environment variables here as your apps need them.
