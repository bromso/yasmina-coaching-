# Publishes every app's image to GHCR on pushes to main. Disabled by default — rename to
# docker-build.yml to enable. (Pull requests are already covered by the build-only `docker` job in
# ci.yml.) Images: ghcr.io/<owner>/<repo>/<app>:<branch | sha | latest>.
#
# The images bake the production domain in at build time, from repository variables
# (Settings → Secrets and variables → Actions → Variables):
#   SITE_DOMAIN   required — the parent domain, e.g. acme.com. The job fails without it rather than
#                 publish images whose links point at brand.localhost.
#   COOKIE_DOMAIN optional — the consent cookie's domain on the static apps (www, docs, help, jobs,
#                 blog), `.`-prefixed, e.g. .acme.com. Empty → a host-only consent cookie, so the
#                 choice is not shared across subdomains. (app, auth and account read COOKIE_DOMAIN
#                 at runtime.)
#   CONTENT_REPO_URL optional — docs only: the "Edit on GitHub" base, e.g.
#                 https://github.com/<owner>/<repo>/blob/main/apps/docs/content/docs. Empty → no link.
# See docs/guides/deploying.md.
name: Docker Build & Push

on:
  push:
    branches: [main]
    paths:
      - "apps/**"
      - "packages/**"
      - "docker/**"
      - "bun.lock"
      - "package.json"
      - ".github/workflows/docker-build.yml"

env:
  REGISTRY: ghcr.io
  IMAGE_PREFIX: ${{ github.repository }}

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    strategy:
      fail-fast: false
      matrix:
        include:
          - { dockerfile: next, app: www, port: 3000 }
          - { dockerfile: next, app: app, port: 3001 }
          - { dockerfile: next, app: auth, port: 3002 }
          - { dockerfile: next, app: account, port: 3003 }
          - { dockerfile: next, app: docs, port: 3004 }
          - { dockerfile: next, app: help, port: 3005 }
          - { dockerfile: next, app: jobs, port: 3006 }
          - { dockerfile: next, app: blog, port: 3009 }
          - { dockerfile: bun-service, app: api, port: 3007 }
          - { dockerfile: bun-service, app: ai, port: 3008 }
    steps:
      - uses: actions/checkout@v7

      - uses: docker/setup-buildx-action@v4

      - name: Login to GitHub Container Registry
        uses: docker/login-action@v4
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@v6
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_PREFIX }}/${{ matrix.app }}
          tags: |
            type=ref,event=branch
            type=sha,prefix=
            type=raw,value=latest,enable=${{ github.ref == 'refs/heads/main' }}

      - name: Require the production domain
        env:
          SITE_DOMAIN: ${{ vars.SITE_DOMAIN }}
        run: |
          if [ -z "$SITE_DOMAIN" ]; then
            echo "::error::Set the SITE_DOMAIN repository variable (Settings → Secrets and variables → Actions → Variables) — images bake it in at build time."
            exit 1
          fi

      - name: UTC date
        # APT_REFRESH busts the Dockerfiles' apt-get upgrade layer, which the gha build cache would
        # otherwise reuse forever — a published image picks up Debian's patches at least daily.
        id: date
        run: echo "date=$(date -u +%Y-%m-%d)" >> "$GITHUB_OUTPUT"

      - name: Build and push
        uses: docker/build-push-action@v7
        with:
          context: .
          file: docker/${{ matrix.dockerfile }}.Dockerfile
          build-args: |
            APP=${{ matrix.app }}
            PORT=${{ matrix.port }}
            SITE_DOMAIN=${{ vars.SITE_DOMAIN }}
            COOKIE_DOMAIN=${{ vars.COOKIE_DOMAIN }}
            CONTENT_REPO_URL=${{ vars.CONTENT_REPO_URL }}
            APT_REFRESH=${{ steps.date.outputs.date }}
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha,scope=${{ matrix.app }}
          cache-to: type=gha,mode=max,scope=${{ matrix.app }}
